# ==============================================================================
# CONFIGURACIÓN GENERAL - AUTOMETRICA BACKEND
# ==============================================================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/autometrica_db

# ==============================================================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO REAL (GMAIL SMTP)
# ==============================================================================
# Para usar Gmail:
# 1. Activa la verificación en 2 pasos en tu cuenta de Google.
# 2. Ve a https://myaccount.google.com/apppasswords y genera una "Contraseña de aplicación".
# 3. Pega la contraseña de 16 caracteres generada en SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion_16_caracteres
SMTP_FROM_NAME=AutoMétrica Soporte
SMTP_FROM_EMAIL=tu_correo@gmail.com

# ==============================================================================
# CONFIGURACIÓN DE MENSAJES DE TEXTO SMS (TWILIO)
# ==============================================================================
# Opcional para enviar SMS reales a celulares. Si no se configuran,
# el sistema emitirá el SMS simulado en la consola sin errores.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
